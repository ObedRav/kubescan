%--- Azul corporativo UNIR de la plantilla 2026: #0098CD.
\definecolor{azulunir}{rgb}{0,0.596,0.804}

\newcommand\director[1]{\def\@director{#1}}
\newcommand\nombreciudad[1]{\def\@nombreciudad{#1}}
\newcommand\titulacion[1]{\def\@titulacion{#1}}
\newcommand\tipotrabajo[1]{\def\@tipotrabajo{#1}}
\director{}
\nombreciudad{}
\tipotrabajo{}

%--- Jerarquía de títulos de la plantilla UNIR 2026:
%    Título 1: 18 pt, regular, azul  (numeración «1.»)
%    Título 2: 14 pt, regular, azul  (numeración «1.1.»)
%    Título 3: 12 pt, negrita, redonda, negro    (numeración «1.1.1.»)
%    Título 4: 12 pt, regular, negro             (numeración «1.1.1.1.»)
\titleformat{\chapter}[hang]{\fontsize{18pt}{22pt}\selectfont\calibrilight\color{azulunir}}{\thechapter.}{0.5em}{}
\titleformat{name=\chapter,numberless}[hang]{\fontsize{18pt}{22pt}\selectfont\calibrilight\color{azulunir}}{}{0pt}{}
%--- El título de capítulo comienza en el margen superior del cuerpo (2,5 cm),
%    sin el hueco de 50 pt que el estilo book añade por defecto.
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{18pt}
\titleformat{\section}{\fontsize{14pt}{17pt}\selectfont\calibrilight\color{azulunir}}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalsize\calibrilight\bfseries}{\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\mdseries}{\thesubsubsection.}{0.5em}{}
%--- Espaciado de la plantilla Word (6 pt antes/después de cada título): sin
%    esto, titlesec usa sus valores por defecto (varias veces mayores), que se
%    suman al \parskip de los párrafos vecinos en lugar de sustituirlo.
\titlespacing*{\section}{0pt}{6pt}{6pt}
\titlespacing*{\subsection}{0pt}{6pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{6pt}{6pt}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

%--- Anexos: «Anexo A. Título», sin mayúsculas forzadas (estilo «Anexo»).
\newcommand{\activaformatoanexo}{%
  \titleformat{\chapter}[hang]{\fontsize{18pt}{22pt}\selectfont\calibrilight\color{azulunir}}{\appendixname~\thechapter.}{0.5em}{}%
}




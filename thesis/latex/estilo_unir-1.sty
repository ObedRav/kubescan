\usepackage{colortbl}

%--- Identificadores monoespaciados largos con guion bajo (p.ej. TRUE_HOST_PID)
%    no tienen puntos de corte propios; en párrafos justificados fuerzan huecos
%    enormes entre palabras. \identcode permite partir tras cada guion bajo
%    (se usa igual que \texttt, escribiendo el guion bajo como \_).
\newcommand{\identcode}[1]{\begingroup
  \let\oldunderscore\_%
  \renewcommand{\_}{\oldunderscore\allowbreak}%
  \texttt{#1}%
\endgroup}

%cabeceras y pies de página
\usepackage{vmargin}
%--- Márgenes exigidos por la plantilla UNIR: izq 3,0 cm, der 2,0 cm, sup/inf 2,5 cm.
\setpapersize{A4}
%--- Cabecera a 1,25 cm del borde; el cuerpo comienza a 2,5 cm
%    (1,25 cm + altura de cabecera 24pt + separación 11pt ≈ 2,5 cm).
\setmarginsrb{3cm}{1.25cm}{2cm}{2.5cm}{24pt}{11pt}{0pt}{24pt}
\usepackage{fancyhdr}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0.0pt}
\setlength{\headheight}{24pt}%

%--- Formato de párrafo de la plantilla Word (Normal: before=120, after=120
%    twips = 6pt+6pt = 12pt entre párrafos consecutivos): sin sangría.
\setlength{\parindent}{0pt}
\setlength{\parskip}{12pt}

%--- Títulos de tablas y figuras (arriba), fuente al pie: número en negrita,
%    nombre en cursiva, según la plantilla UNIR.
\usepackage{caption}
%--- Estilo «Descripción» de la plantilla: todo el pie en negrita 10 pt,
%    el título además en cursiva («Tabla 1. \textit{Título}.»).
\captionsetup{labelfont=bf,textfont={bf,it},labelsep=period,justification=centering,font=footnotesize}
\captionsetup[table]{position=above,skip=6pt}
\captionsetup[figure]{position=above,skip=6pt}

\renewcommand{\maketitle}{\creaportada}

\renewcommand{\baselinestretch}{1.5}



\usepackage{etoolbox}
\patchcmd{\chapter}{\if@openright\cleardoublepage\else\clearpage\fi}{\if@openright\clearpage\else\clearpage\fi}{}{}




research/models/checkpoints_seeds/**/*.pt
research/models/checkpoints/test_results.json.bak

# ── Trained model checkpoints ───────────────────────────────────────────────────
# The .pt and .skops artefacts ARE tracked (~27 MB): RNF-2 requires that a clone
# reproduce a scan without retraining, and the appendix points readers here.
# Reproduce from scratch instead with:
#   python research/models/train_rf.py && train_gnn.py && run_ga_ensemble.py
#
# The legacy .pkl duplicates stay out: they are superseded by the .skops files
# (rf_classifier.py prefers .skops and warns that pickle executes arbitrary
# bytecode on load), so shipping them would add 5.8 MB of unsafe redundancy.
research/models/checkpoints/*.pkl

# Personal thesis working notes (not part of the deliverable; some predate the
# 2026-06 group-aware protocol correction and contain superseded numbers)
thesis/MEJORAS_PENDIENTES.md
thesis/memory/
thesis/process-docs/

# ── Pipeline run logs ───────────────────────────────────────────────────────────
research/models/*.log
research/models/retrain_*.log
research/*.log


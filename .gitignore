# ── Trained model checkpoints (large binary, regenerable via train_*.py) ────────
# Stored outside git to avoid iCloud eviction causing SIGBUS in pack-objects.
# Reproduce: python research/models/train_rf.py && train_gnn.py && run_ga_ensemble.py
research/models/checkpoints/*.pt
research/models/checkpoints/*.skops
research/models/checkpoints/*.pkl
research/models/checkpoints/gnn_best.pt

# Personal thesis working notes (not part of the deliverable; some predate the
# 2026-06 group-aware protocol correction and contain superseded numbers)
thesis/MEJORAS_PENDIENTES.md
thesis/memory/
thesis/process-docs/

# ── Pipeline run logs ───────────────────────────────────────────────────────────
research/models/*.log
research/models/retrain_*.log
research/*.log

